#!/bin/sh
# 为旧版保留配置补齐双端口字段；既有显式选择不被覆盖。
if [ -f /usr/lib/ourfreemodel-access/migrate.mjs ]; then
  /usr/bin/node /usr/lib/ourfreemodel-access/migrate.mjs || exit 1
fi
uci -q get ourfreemodel.main >/dev/null || uci set ourfreemodel.main=ourfreemodel
uci -q get ourfreemodel.main.enabled >/dev/null || uci set ourfreemodel.main.enabled='1'
if ! uci -q get ourfreemodel.main.api_port >/dev/null; then
  old_port=$(uci -q get ourfreemodel.main.port)
  uci set ourfreemodel.main.api_port="${old_port:-18900}"
fi
default_interface=lan
old_host=$(uci -q get ourfreemodel.main.host)
case "$old_host" in
  127.0.0.1|::1) default_interface=loopback ;;
esac
for kind in api web; do
  uci -q get "ourfreemodel.main.${kind}_interface" >/dev/null || uci set "ourfreemodel.main.${kind}_interface=$default_interface"
  if [ "$default_interface" = loopback ] && ! uci -q get "ourfreemodel.main.${kind}_address" >/dev/null; then
    uci set "ourfreemodel.main.${kind}_address=$old_host"
  fi
done
if ! uci -q get ourfreemodel.main.web_public_origin >/dev/null; then
  old_origin=$(uci -q get ourfreemodel.main.public_origin)
  [ -z "$old_origin" ] || uci set "ourfreemodel.main.web_public_origin=$old_origin"
fi
if ! uci -q get ourfreemodel.main.web_port >/dev/null; then
  web_port=18901
  [ "$(uci -q get ourfreemodel.main.api_port)" = "$web_port" ] && web_port=18902
  uci set "ourfreemodel.main.web_port=$web_port"
fi
uci commit ourfreemodel
# 默认数据目录在 /etc 下，并写入 sysupgrade 保留列表，保证升级时账号与用量不丢。
data_dir=$(uci -q get ourfreemodel.main.data_dir)
[ -n "$data_dir" ] || data_dir=/etc/ourfreemodel
mkdir -p "$data_dir"
case "$data_dir" in
  /etc/*)
    grep -qxF "$data_dir" /etc/sysupgrade.conf 2>/dev/null || echo "$data_dir" >> /etc/sysupgrade.conf ;;
esac
# 首次安装即生成随机 WebUI 密码，LuCI 可直接查看并复制。
if [ -f /usr/lib/ourfreemodel-access/password.mjs ] && [ -x /usr/bin/node ]; then
  /usr/bin/node /usr/lib/ourfreemodel-access/password.mjs generate || exit 1
fi
exit 0
