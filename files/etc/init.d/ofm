#!/bin/sh /etc/rc.common
# OurFreeModel：API Key 模型端口与密码 WebUI 分别监听。
USE_PROCD=1
START=99
STOP=15
EXTRA_COMMANDS="password reload_password"
EXTRA_HELP="	password 设置或重置 WebUI 密码，不中断模型 API"

start_service() {
  config_load openwrt-ofm
  local enabled data_dir api_port api_interface api_address web_port web_interface web_address web_public_origin
  config_get_bool enabled main enabled 1
  [ "$enabled" = 1 ] || return 0
  config_get data_dir main data_dir /usr/lib/ofm-data
  config_get api_port main api_port 18900
  config_get api_interface main api_interface lan
  config_get api_address main api_address ''
  config_get web_port main web_port 18901
  config_get web_interface main web_interface lan
  config_get web_address main web_address ''
  config_get web_public_origin main web_public_origin ''
  mkdir -p "$data_dir"
  procd_open_instance main
  procd_set_param command /usr/bin/node /usr/lib/ofm-access/cli.mjs
  procd_set_param env OFM_HOME="$data_dir" \
    OFM_API_PORT="$api_port" OFM_API_INTERFACE="$api_interface" OFM_API_ADDRESS="$api_address" \
    OFM_WEB_PORT="$web_port" OFM_WEB_INTERFACE="$web_interface" OFM_WEB_ADDRESS="$web_address" \
    OFM_WEB_PUBLIC_ORIGIN="$web_public_origin"
  procd_set_param file /etc/config/openwrt-ofm
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param respawn 3600 10 5
  procd_set_param term_timeout 15
  procd_close_instance
}

reload_service() {
  stop
  start
}

service_triggers() {
  procd_add_reload_trigger openwrt-ofm
  config_load openwrt-ofm
  local api_interface web_interface
  config_get api_interface main api_interface lan
  config_get web_interface main web_interface lan
  [ "$api_interface" = '*' ] || procd_add_interface_trigger 'interface.*' "$api_interface" /etc/init.d/ofm reload
  if [ "$web_interface" != '*' ] && [ "$web_interface" != "$api_interface" ]; then
    procd_add_interface_trigger 'interface.*' "$web_interface" /etc/init.d/ofm reload
  fi
}

reload_password() {
  /etc/init.d/ofm running || return 0
  procd_send_signal ofm main HUP
}

password() {
  /usr/bin/node /usr/lib/ofm-access/password.mjs /etc/ofm-access.json || return 1
  reload_password
}
