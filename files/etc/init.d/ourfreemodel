#!/bin/sh /etc/rc.common
# OurFreeModel：API Key 模型端口与密码 WebUI 分别监听。
USE_PROCD=1
START=99
STOP=15
EXTRA_COMMANDS="password reload_password"
EXTRA_HELP="	password 设置或重置 WebUI 密码，不中断模型 API"

# 首次启动时生成随机 WebUI 密码；已有密码不会改动。明文仅供 LuCI 查看复制。
ensure_password() {
  [ -f /usr/lib/ourfreemodel-access/password.mjs ] || return 0
  /usr/bin/node /usr/lib/ourfreemodel-access/password.mjs generate >/dev/null 2>&1 || \
    logger -t ourfreemodel 'WebUI 随机密码初始化失败，请检查 node 与 /etc 写入权限'
}

start_service() {
  config_load ourfreemodel
  local enabled data_dir api_port api_interface api_address web_port web_interface web_address web_public_origin
  config_get_bool enabled main enabled 1
  [ "$enabled" = 1 ] || return 0
  ensure_password
  config_get data_dir main data_dir /etc/ourfreemodel
  config_get api_port main api_port 18900
  config_get api_interface main api_interface lan
  config_get api_address main api_address ''
  config_get web_port main web_port 18901
  config_get web_interface main web_interface lan
  config_get web_address main web_address ''
  config_get web_public_origin main web_public_origin ''
  mkdir -p "$data_dir"
  procd_open_instance main
  procd_set_param command /usr/bin/node /usr/lib/ourfreemodel-access/cli.mjs
  procd_set_param env OURFREEMODEL_HOME="$data_dir" \
    OURFREEMODEL_API_PORT="$api_port" OURFREEMODEL_API_INTERFACE="$api_interface" OURFREEMODEL_API_ADDRESS="$api_address" \
    OURFREEMODEL_WEB_PORT="$web_port" OURFREEMODEL_WEB_INTERFACE="$web_interface" OURFREEMODEL_WEB_ADDRESS="$web_address" \
    OURFREEMODEL_WEB_PUBLIC_ORIGIN="$web_public_origin"
  procd_set_param file /etc/config/ourfreemodel
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param respawn 3600 10 5
  procd_set_param term_timeout 15
  procd_close_instance
}

reload_service() {
  stop
  start
}

service_triggers() {
  procd_add_reload_trigger ourfreemodel
  config_load ourfreemodel
  local api_interface web_interface
  config_get api_interface main api_interface lan
  config_get web_interface main web_interface lan
  [ "$api_interface" = '*' ] || procd_add_interface_trigger 'interface.*' "$api_interface" /etc/init.d/ourfreemodel reload
  if [ "$web_interface" != '*' ] && [ "$web_interface" != "$api_interface" ]; then
    procd_add_interface_trigger 'interface.*' "$web_interface" /etc/init.d/ourfreemodel reload
  fi
}

reload_password() {
  /etc/init.d/ourfreemodel running || return 0
  procd_send_signal ourfreemodel main HUP
}

password() {
  /usr/bin/node /usr/lib/ourfreemodel-access/password.mjs /etc/ourfreemodel-access.json || return 1
  reload_password
}
